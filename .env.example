# Kopieren nach .env und anpassen

# Pfad zur SQLite-Datenbank
HEIZOEL_DB_PATH=data/heizoel.db

# Geheimnis für Session-Cookies (lang, zufällig)
HEIZOEL_SECRET_KEY=change-me

# Registrierung nur mit diesem Einladungscode
HEIZOEL_INVITE_CODE=familie

# Öffentliche URL der App (für Links in Mails)
HEIZOEL_APP_URL=http://localhost:8000

# EIA Open Data API Key (kostenlos: https://www.eia.gov/opendata/register.php)
HEIZOEL_EIA_API_KEY=

# Mail-Versand (leer lassen = Mails werden nur geloggt)
HEIZOEL_SMTP_HOST=
HEIZOEL_SMTP_PORT=587
HEIZOEL_SMTP_USER=
HEIZOEL_SMTP_PASSWORD=
HEIZOEL_MAIL_FROM=heizoel@example.org

# Uhrzeit des täglichen Laufs (lokale Zeit, HH:MM)
HEIZOEL_DAILY_RUN_AT=06:30

# Nachrichten-Lagebild (Phase 2). none = aus, anthropic = Claude-API, ollama = lokal
HEIZOEL_LLM_DRIVER=none
HEIZOEL_LLM_MODEL=claude-opus-5-5
HEIZOEL_LLM_EFFORT=low
HEIZOEL_ANTHROPIC_API_KEY=
HEIZOEL_OLLAMA_URL=http://localhost:11434
